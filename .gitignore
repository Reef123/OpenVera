# Secrets — NEVER commit
.secrets
.secrets.*
!.secrets.template
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node (if used by projects)
node_modules/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# User write paths — generated content, personal data. Keep breadcrumb READMEs.
vera-projects/projects/*
!vera-projects/projects/README.md
vera-projects/research-output/*
!vera-projects/research-output/README.md
vera-system/conversations/*
!vera-system/conversations/.gitkeep
!vera-system/conversations/README.md

# Personal files — ship as *.template, bootstrap copies to working paths.
# Prevents accidental `git add .` from pushing user data upstream in a PR.
vera-system/relationships/user.md
vera-system/state.md
vera-system/memory/MEMORY.md
vera-system/ideas.md
vera-system/ROADMAP.md

# Per-user bootstrap state (generated by bootstrap.sh, not harness source)
**/.claude/last-curate-date
**/.claude/last-dream-date
**/.claude/bootstrapped
# Machine-local settings override (written by bootstrap when python3 isn't the local Python command)
.claude/settings.local.json

# Runtime telemetry + signal logs (appended by scripts/telemetry.py and skills)
vera-system/runs/*
!vera-system/runs/.gitkeep
!vera-system/runs/README.md

# Logs
*.log

# Local planning docs — not shipped
BUILD-PRO-PLAN.md
BUILD-SKILL-SPLIT-PLAN.md

# Screenshots (build verification artifacts — saved per-project, not at root)
*.png
!assets/*.png
